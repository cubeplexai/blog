{
  "name": "cubeplex-blog",
  "version": "0.1.0",
  "private": true,
  "description": "The official CubePlex blog.",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build && node scripts/normalize-url-format.mjs build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "optimize:images": "node scripts/optimize-blog-images.mjs",
    "typecheck": "tsc",
    "check:urls": "node scripts/check-url-format.mjs build",
    "check": "pnpm build && pnpm typecheck && pnpm check:urls"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-blog": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.0"
  }
}
